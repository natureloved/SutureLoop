# SutureLoop Environment Configuration

# 1. Neatlogs Telemetry (Required for live cloud reporting)
# Obtain your Project API key from app.neatlogs.com -> Settings -> API Keys (not the nlw_ ingest key)
NEATLOGS_API_KEY=your_neatlogs_project_api_key_here
TRACE_URL_TEMPLATE=https://app.neatlogs.com/traces/${id}

# 2. LLM Provider (One of the following for synthesis engine)
OPENROUTER_API_KEY=your_openrouter_api_key_here
# ANTHROPIC_API_KEY=your_anthropic_api_key_here
# OPENAI_API_KEY=your_openai_api_key_here

# Optional: AWS Bedrock
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=your_key
# AWS_SECRET_ACCESS_KEY=your_secret

# 3. Server Configuration
PORT=3000
NODE_ENV=development

# 4. SutureLoop Operational Parameters
DEMO_FORCE_FAULT=false
# Attempt budget: attempt 1 uses the strategy the blast radius supports,
# attempts 2..RETRY_LIMIT are always context-informed. Malformed values fall
# back to the default rather than disabling the bound.
RETRY_LIMIT=2
DEFAULT_ENGINEER_HOURLY_RATE=125
DEFAULT_INCIDENT_MTTR_MINUTES=45
# A hung regression run must fail its attempt, not freeze the agent.
REGRESSION_TEST_TIMEOUT_MS=120000

# 5. Inbound Incident Webhook
# POST /api/v1/incidents/ingest accepts runtime crash spans from other services.
#
# SUTURELOOP_INGEST_MODE:
#   auto-heal   (default) record the span and remediate it immediately
#   record-only record the span and stop -- an inbound HTTP request can never
#               cause a source file to be rewritten
SUTURELOOP_INGEST_MODE=auto-heal
# URL the bundled express middleware forwards crashes to.
SUTURELOOP_INGEST_URL=http://localhost:3000/api/v1/incidents/ingest
# When set, remote callers must present it as `x-sutureloop-secret` (or send it
# as a Bearer token). While unset, only loopback callers are accepted.
SUTURELOOP_WEBHOOK_SECRET=

# 6. Automated Remediation Pull Request (off by default)
# When enabled, a successful heal is committed on a branch and pushed to origin.
# The target is re-checked against the remediation boundary immediately before
# staging, so a path outside the sandbox can never reach the remote.
ENABLE_REMOTE_PR=false
GITHUB_TOKEN=
GITHUB_REPO=natureloved/SutureLoop
