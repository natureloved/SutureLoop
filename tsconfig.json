{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "outDir": "./dist",
    "declaration": true,
    "rootDir": "./",
    "resolveJsonModule": true
  },
  "include": ["src/**/*", "bin/**/*", "demo/**/*"],
  "exclude": ["node_modules", "dist"]
}
